config image-path ../../../inet-4.6.0/images
config network omnet_tictoc.Network
config sim-time-limit 10s
config *.host*.ipv4.arp.typename GlobalArp
config *.hostA.mobility.typename StationaryMobility
config *.hostB.mobility.typename StationaryMobility
